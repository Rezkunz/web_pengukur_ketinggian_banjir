{
  "rules": {
    // [SECURITY] Default: TOLAK semua akses yang tidak didefinisikan secara eksplisit
    ".read": false,
    ".write": false,

    "sensor_data": {
      // [SECURITY] Hanya pengguna terautentikasi yang TERDAFTAR di sistem yang bisa membaca.
      // Ini menyelesaikan peringatan Firebase: user harus ada di /users (bukan hanya login dengan email sembarang).
      ".read": "auth != null && (auth.token.admin === true || root.child('users').child(auth.uid).exists())",
      // Hanya Admin (Custom Claims) atau Device IoT yang bisa menulis data sensor
      ".write": "auth != null && (auth.token.admin === true || auth.token.email === 'device@safe.id')"
    },

    "history": {
      // Hanya Admin yang bisa baca history
      ".read": "auth != null && auth.token.admin === true",
      ".write": "auth != null && auth.token.admin === true"
    },

    "laporan": {
      // Hanya Admin yang bisa melihat daftar semua laporan
      ".read": "auth != null && auth.token.admin === true",
      // Semua pengguna terautentikasi bisa mengirim laporan
      ".write": "auth != null"
    },

    "saran": {
      // Hanya Admin yang bisa melihat saran
      ".read": "auth != null && auth.token.admin === true",
      // Semua pengguna terautentikasi bisa mengirim saran
      ".write": "auth != null"
    },

    "users": {
      // Izinkan Admin membaca seluruh daftar pengguna untuk statistik dashboard
      ".read": "auth != null && auth.token.admin === true",
      "$uid": {
        // Pengguna bisa membaca profilnya sendiri, Admin bisa baca semua
        ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true)",

        // Pengguna bisa update profilnya sendiri (kecuali field sensitif), Admin bisa update semua
        ".write": "auth != null && (auth.uid === $uid || auth.token.admin === true)",

        "role": {
          // [SECURITY] Field 'role' di DB hanya untuk tampilan UI
          // Otoritas ASLI ada di Firebase Custom Claims (tidak bisa dimanipulasi via DB)
          ".write": "auth != null && auth.token.admin === true"
        },

        "fcm_tokens": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    }
  }
}
